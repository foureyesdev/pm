{
  "engine": "SQLite",
  "file": "/data/fieldwork.sqlite3",
  "connection_pragmas": ["foreign_keys = ON"],
  "table_mode": "STRICT",
  "stage_order": ["backlog", "ready", "progress", "review", "done"],
  "tables": {
    "users": {
      "columns": {
        "id": "INTEGER PRIMARY KEY",
        "username": "TEXT NOT NULL UNIQUE CHECK (length(trim(username)) > 0)"
      }
    },
    "boards": {
      "columns": {
        "id": "INTEGER PRIMARY KEY",
        "user_id": "INTEGER NOT NULL UNIQUE REFERENCES users(id)",
        "title": "TEXT NOT NULL",
        "description": "TEXT NOT NULL DEFAULT ''",
        "revision": "INTEGER NOT NULL DEFAULT 0 CHECK (revision >= 0)"
      }
    },
    "board_columns": {
      "columns": {
        "board_id": "INTEGER NOT NULL REFERENCES boards(id)",
        "id": "TEXT NOT NULL CHECK (id IN ('backlog', 'ready', 'progress', 'review', 'done'))",
        "name": "TEXT NOT NULL CHECK (length(trim(name)) > 0)"
      },
      "constraints": ["PRIMARY KEY (board_id, id)"],
      "order": "stage_order"
    },
    "cards": {
      "columns": {
        "board_id": "INTEGER NOT NULL",
        "id": "TEXT NOT NULL",
        "column_id": "TEXT NOT NULL",
        "title": "TEXT NOT NULL CHECK (length(trim(title)) > 0)",
        "details": "TEXT NOT NULL DEFAULT ''",
        "position": "INTEGER NOT NULL CHECK (position >= 0)"
      },
      "constraints": [
        "PRIMARY KEY (board_id, id)",
        "FOREIGN KEY (board_id, column_id) REFERENCES board_columns(board_id, id)",
        "UNIQUE (board_id, column_id, position)"
      ],
      "order": "position ASC within each board and column"
    },
    "chat_messages": {
      "columns": {
        "id": "INTEGER PRIMARY KEY",
        "board_id": "INTEGER NOT NULL REFERENCES boards(id)",
        "role": "TEXT NOT NULL CHECK (role IN ('user', 'assistant'))",
        "content": "TEXT NOT NULL CHECK (length(trim(content)) > 0)"
      },
      "order": "id ASC within each board"
    }
  },
  "indexes": ["CREATE INDEX chat_messages_by_board ON chat_messages(board_id, id)"]
}
